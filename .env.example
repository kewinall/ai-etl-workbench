# 展示模式：尚未提供 PostgreSQL 連線時保持 mock；填妥後改為 postgres
APP_MODE=mock
DATABASE_URL=postgresql://TODO_USER:TODO_PASSWORD@TODO_HOST:5432/ai_agents
VERTICA_HOST=127.0.0.1
VERTICA_PORT=5433
VERTICA_DATABASE=VMart
VERTICA_USER=dbadmin
VERTICA_PASSWORD=TODO_VERTICA_PASSWORD
VERTICA_TLSMODE=disable
CODEX_CLI_PATH=C:\Users\YOUR_USER\AppData\Roaming\npm\codex.cmd
COPILOT_CLI_PATH=C:\Users\YOUR_USER\AppData\Roaming\npm\copilot.cmd
CODEX_NODE_DIR=C:\Program Files\nodejs
HOP_RUN_PATH=D:\ChatGPT\ai_agents_v2\hop\hop-run.bat
HOP_PROJECT_PATH=D:\ChatGPT\ai_agents_v2\hop-project
RUNTIME_TEMP=D:\ChatGPT\ai_agents_v2\runtime-temp
ANALYZER_SCAN_ROOT=D:\ChatGPT\ai_agents_v2\scan
VALIDATION_SAMPLE_POLICY=FIRST_10_VALID_ROWS
VALIDATION_SAMPLE_SIZE=10
LITELLM_API_BASE=http://127.0.0.1:4000
# 32-byte base64 key; store it in Windows Credential Manager for normal use.
PLATFORM_SETTINGS_ENCRYPTION_KEY=TODO_BASE64_AES_256_KEY
BACKEND_PORT=8765
FRONTEND_PORT=5173
